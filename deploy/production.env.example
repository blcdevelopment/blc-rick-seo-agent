# Production settings for the Rick edition on the shared BLC Linode.
#
# On the box this file becomes ~/blc-rick-seo-agent/.env, chmod 600, never committed:
#
#   cd ~/blc-rick-seo-agent && cp deploy/production.env.example .env && chmod 600 .env && nano .env
#
# docker-compose.prod.yml sets everything that is fixed for this deployment itself: APP_ENV,
# the database / Redis / Celery URLs, the storage paths, CORS, REPORT_PROFILE=teaser,
# PUBLIC_AUDITS_ENABLED, SEARCH_CONSOLE_ENABLED, SOCIAL_AUDITS_ENABLED=false and the worker's
# concurrency. Values for those here are ignored. Anything not listed below falls back to the
# code default, which is the supported production setting (see .env.template for the full list).

# --- PostgreSQL (compose builds DATABASE_URL from these) ---------------------------------------
POSTGRES_DB=blc_rick_seo_agent
POSTGRES_USER=blc
# Required. A new random value, never the parent's: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- The call-to-action that replaces every fix in the teaser report ----------------------------
# Must start with https://, http://, mailto: or tel:. Empty shows the label without a link.
BOOKING_URL=
BOOKING_CTA_LABEL="Book a meeting with Rick"

# --- Operator access (optional) ----------------------------------------------------------------
# Visitors never sign in. With CLERK_ISSUER empty, the operator endpoints (history, reruns, share
# links, /metrics) answer 403 on this deployment. Leave all of these empty unless a Clerk
# production instance is set up for operators (then invitation-only).
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
CLERK_ALLOWED_SUBJECTS=

# --- Integrations (each is optional; blank skips that step of the audit) -----------------------
# These are billed per call, and every public visitor can start an audit. Decide whether this
# edition gets its own keys or shares the parent's quota (DEPLOYMENT.md §3).
GOOGLE_PSI_API_KEY=
OPENAI_API_KEY=
# Social media audits are off in this edition (SOCIAL_AUDITS_ENABLED=false, set by compose), so
# APIFY_API_TOKEN, YOUTUBE_API_KEY and GOOGLE_PLACES_API_KEY are never used: leave them out.

# Firecrawl: used ONLY when a site's security (e.g. SiteGround's bot check) blocks this server's
# browser on the homepage; the pages are then fetched through Firecrawl instead. Empty = off
# (those audits fail with the plain "security check blocked our scanner" message). One credit
# per page. The caps have code defaults that fit Firecrawl's free plan (1,000 credits a month),
# so only the key is needed: CRAWLER_FIRECRAWL_MAX_PAGES (8) pages per audit,
# CRAWLER_FIRECRAWL_DAILY_LIMIT (10) such audits per UTC day (80 credits), and
# CRAWLER_FIRECRAWL_MONTHLY_PAGE_LIMIT (900) credits per UTC month.
FIRECRAWL_API_KEY=

# AI Visibility stays OFF here: Semrush allows one live session per account, and logging in from
# this stack would sign the parent's bot out. Turn it on only with a second Semrush seat.
AI_VISIBILITY_ENABLED=false

# --- Monitoring (optional) ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
ALERT_WEBHOOK_URL=

# --- Housekeeping (defaults shown) -------------------------------------------------------------
STORAGE_RETENTION_DAYS=90

# --- Resource ceilings on the shared box (optional; defaults shown) ----------------------------
# Hard limits per container, so this stack can never starve the live apps. Raise them only if
# the box has grown (DEPLOYMENT.md §7), then run a deploy (or `up -d`) to apply.
# RICK_POSTGRES_MEM_LIMIT=256m
# RICK_REDIS_MEM_LIMIT=128m
# RICK_API_MEM_LIMIT=768m
# RICK_API_CPUS=1.0
# RICK_WORKER_MEM_LIMIT=1536m
# RICK_WORKER_CPUS=1.0
# RICK_FRONTEND_MEM_LIMIT=384m
# RICK_EDGE_MEM_LIMIT=64m
