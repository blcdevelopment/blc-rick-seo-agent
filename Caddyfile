# Reverse proxy + automatic HTTPS for the BLC Website Audit, Rick edition.
#
# NOT DEPLOYED. The site address below is a placeholder on the reserved
# `.invalid` TLD (RFC 2606): it can never resolve or obtain a certificate.
# Replace it with this edition's own subdomain once that is provisioned.
#
# The parent repo's Caddyfile also serves the live ai.builderleadconverter.com
# and the sibling BLC apps (events / reactivation / board). Those blocks are
# removed here on purpose: only the production stack's Caddy may claim them.

blc-rick-seo-agent.invalid {
	encode zstd gzip

	# API: strip the /api prefix, then forward to FastAPI.
	# e.g. https://.../api/audits  ->  http://api:8000/audits
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Everything else -> the Next.js operator UI.
	handle {
		reverse_proxy frontend:3000
	}
}
